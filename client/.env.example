# PostHog Analytics
NEXT_PUBLIC_POSTHOG_KEY=phc_XXXXXXXXXX
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Ventora CRM feedback widget
# NEXT_PUBLIC_CRM_WIDGET_KEY must be set to the product public key issued by the CRM operator.
# Leave blank here; set the real key in .env.local (dev) or via your deployment secrets (prod).
# The widget renders nothing until this key is configured.
NEXT_PUBLIC_CRM_WIDGET_KEY=
# Defaults to https://widgets.ventoralabs.com/w/v1.js. Override only for local CRM dev.
NEXT_PUBLIC_CRM_LOADER_URL=https://widgets.ventoralabs.com/w/v1.js
