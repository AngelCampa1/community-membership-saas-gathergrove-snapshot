  "scripts": {
    "start": "node server.js",
    "dev": "next dev -p 3050",
    "build": "next build",
    "build:staging": "npm run build && node scripts/build-staging-package.js",
    "build:production": "npm run build && node scripts/build-production-package.js",
    "test": "cross-env NODE_OPTIONS=\"--max-old-space-size=8192 --expose-gc\" jest --watchAll=false --passWithNoTests --logHeapUsage --forceExit --no-cache",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e-headed": "playwright test --headed",
    "test:e2e-ui": "playwright test --ui",
    "lint": "cross-env NODE_OPTIONS=\"--max-old-space-size=8192\" eslint --cache .",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit --incremental false",
    "preview": "opennextjs-cloudflare build && wrangler dev",
    "deploy": "opennextjs-cloudflare build && wrangler deploy --keep-vars"
  },
