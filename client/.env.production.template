# Production Environment Variables Template for GatherGrove Client
# Copy this file to .env.production.local and configure with actual values
# DO NOT commit .env.production.local to source control

# ===== API CONFIGURATION =====
# Production API endpoint - should use HTTPS
NEXT_PUBLIC_API_BASE_URL=https://api.gathergrove.club/api/v1

# ===== ENVIRONMENT CONFIGURATION =====
# Set to production for optimized builds
NEXT_PUBLIC_NODE_ENV=production
NODE_ENV=production

# Disable debug logging in production
NEXT_PUBLIC_DEBUG=false

# ===== APPLICATION INSIGHTS =====
# Azure Application Insights connection string
# Configure in Azure App Service Application Settings as:
# @Microsoft.KeyVault(SecretUri=https://gathergrove-keyvault-v2.vault.azure.net/secrets/NEXT-PUBLIC-APPLICATION-INSIGHTS-CONNECTION-STRING/)
NEXT_PUBLIC_APPLICATION_INSIGHTS_CONNECTION_STRING=

# ===== STRIPE CONFIGURATION =====
# Stripe publishable key (safe to expose publicly)
# Configure in Azure App Service Application Settings as:
# @Microsoft.KeyVault(SecretUri=https://gathergrove-keyvault-v2.vault.azure.net/secrets/NEXT-PUBLIC-STRIPE-PUBLISHABLE-KEY/)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Stripe Price IDs - Configure in Azure Key Vault
NEXT_PUBLIC_STRIPE_GROW_WEEKLY_PRICE_ID=
NEXT_PUBLIC_STRIPE_GROW_MONTHLY_PRICE_ID=
NEXT_PUBLIC_STRIPE_UNLIMITED_WEEKLY_PRICE_ID=
NEXT_PUBLIC_STRIPE_UNLIMITED_MONTHLY_PRICE_ID=

# Legacy compatibility
NEXT_PUBLIC_STRIPE_GROW_PRICE_ID=

# ===== GOOGLE ANALYTICS (OPTIONAL) =====
# Google Analytics 4 Measurement ID
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ===== BUILD CONFIGURATION =====
# Application version - typically set by CI/CD pipeline
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_BUILD_ID=production

# ===== SECURITY CONFIGURATION =====
# Enable security headers and optimizations
NEXT_PUBLIC_ENABLE_SECURITY_HEADERS=true

# ===== CDN AND ASSETS =====
# CDN URL for static assets (optional)
NEXT_PUBLIC_CDN_URL=

# ===== FEATURE FLAGS =====
# Production feature toggles
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_PUSH_NOTIFICATIONS=true
NEXT_PUBLIC_ENABLE_OFFLINE_MODE=false