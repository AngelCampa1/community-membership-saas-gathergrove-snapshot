    getData: jest.fn(),
  },
}));

// Import AFTER mocking
import { MyService } from '@/services/myService';
const mockMyService = MyService as jest.Mocked<typeof MyService>;

// Usage in beforeEach
mockMyService.getData.mockResolvedValue(expectedData);
```

#### 3. Patterns That Fail

**❌ WRONG - Imports after mocks:**
```typescript
jest.mock('@/hooks/useAuth', () => ({
  useAuth: jest.fn(),
}));
import { useAuth } from '@/hooks/useAuth'; // Too late!
```

**❌ WRONG - Direct function return for router:**
```typescript
jest.mock('next/navigation', () => ({
  useRouter: () => ({ push: mockPush }), // Can't change in tests
}));
```

**❌ WRONG - No explicit implementation:**
```typescript
jest.mock('@/hooks/useAuth'); // No implementation provided
const mockUseAuth = useAuth as jest.MockedFunction<typeof useAuth>;
// TypeError: mockReturnValue is not a function
```

### Key Rules - PROVEN IN 8/8 PASSING TESTS
1. **Import order**: ALL imports BEFORE ALL mocks
2. **jest.fn() for hooks**: Always use `useAuth: jest.fn()` in mock setup
3. **Router setup**: Use `jest.fn()` for useRouter, set return value in beforeEach
4. **mockReturnValue in beforeEach**: Set up return values in beforeEach, not mock definition
5. **Service imports**: Import services AFTER mocking them

### Exact Working Pattern - Copy This Structure
```typescript
// Step 1: ALL IMPORTS FIRST
import React from 'react';
import { render, screen, waitFor } from '@testing-library/react';
import { useRouter } from 'next/navigation';
import MyComponent from '../page';
import { useAuth } from '@/hooks/useAuth';

// Step 2: ALL MOCKS SECOND
jest.mock('next/navigation', () => ({ useRouter: jest.fn() }));
jest.mock('@/hooks/useAuth', () => ({ useAuth: jest.fn() }));
jest.mock('@/services/myService', () => ({ MyService: { getData: jest.fn() } }));

// Step 3: SERVICE IMPORTS THIRD
import { MyService } from '@/services/myService';

// Step 4: MOCK ASSIGNMENTS FOURTH
const mockPush = jest.fn();
const mockUseAuth = useAuth as jest.MockedFunction<typeof useAuth>;
const mockMyService = MyService as jest.Mocked<typeof MyService>;

// Step 5: beforeEach SETUP
beforeEach(() => {
  jest.clearAllMocks();
  (useRouter as jest.Mock).mockReturnValue({ push: mockPush });
  mockUseAuth.mockReturnValue({ user: mockUser, loading: false, ... });
  mockMyService.getData.mockResolvedValue(mockData);
});
```

### TypeScript Considerations
- Add `as any` for function mocks if TypeScript complains: `login: jest.fn() as any`
- Focus on test functionality over perfect typing in test files
- Use `as jest.MockedFunction<typeof hookName>` for type safety

