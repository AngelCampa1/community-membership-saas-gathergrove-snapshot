}));

// Assignment after imports
const mockUseAuth = useAuth as jest.MockedFunction<typeof useAuth>;

// Usage in beforeEach
mockUseAuth.mockReturnValue({
  user: mockUser,
  loading: false,
  login: jest.fn(),
  logout: jest.fn(),
  register: jest.fn(),
