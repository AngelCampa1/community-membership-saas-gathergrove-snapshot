# GatherGrove Project .gitignore

# Worktrees
.worktrees/

# IDE and Editor files
.vscode/
.idea/
*.swp
*.swo
*~
mobile/test-results/
mobile/playwright-report/
mobile/reports/mobile-test-monitoring/
# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*_output.txt
*_results.txt
*_summary.txt
scripts/seed-logs/

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Service account credentials and private keys
**/google-service-account.json
**/google-services.json
*.p8
*.mobileprovision
*.cer

# Local appsettings overrides (contain secrets)
**/appsettings.*.local.json
appsettings.Development.local.json
appsettings.Production.local.json

# Temporary files
*.tmp
*.temp
cookies.txt

# Build artifacts
dist/
build/
*.dll
*.pdb
*.exe
bin/
obj/

# .NET build outputs
**/bin/
**/obj/
**/*.user
**/*.suo
**/*.cache
**/*.docstates

# Next.js build outputs
.next/
out/

# Font files that might be auto-generated
*.ttf
*.woff
*.woff2
*.eot

# Deployment packages and scripts
*.zip
deploy-package/
staging-deploy-package/
simple-deploy/
deploy-staging.sh
startup.sh
package.json.deploy
publish/
temp-deploy/

# Frontend build artifacts
client/.next/
client/out/
client/tsconfig.tsbuildinfo
client/staging-deploy*/
client/*deploy*.zip
client/simple-server.js
client/web.config
client/azure-package.json
client/deploy-package.json

# Backend deployment artifacts
backend/deploy-staging/

# Temporary files and random artifacts
ziCqbum4

# Documentation
docs/build/

# Coverage reports
coverage/
*.lcov
**/coverage-*/
**/TestCoverage*/

# Dependency directories
node_modules/

# Database files
*.db
*.sqlite
*.sqlite3

# Backup files
*.bak
*.backup 
*LogFiles
*deployments
/.playwright-mcp/*

# Claude Flow generated files
.claude/settings.local.json
.mcp.json
claude-flow.config.json
.swarm/
.hive-mind/
memory/claude-flow-data.json
memory/sessions/*
!memory/sessions/README.md
memory/agents/*
!memory/agents/README.md
coordination/memory_bank/*
coordination/subtasks/*
coordination/orchestration/*
*.db
*.db-journal
*.db-wal
*.sqlite
*.sqlite-journal
*.sqlite-wal
claude-flow
claude-flow.bat
claude-flow.ps1
hive-mind-prompt-*.txt
nul

# Cloudflare Workers build output. Previously uncommitted-by-accident: ~20 copies
# of a 271k-line generated worker bundle reached history before this rule existed.
.wrangler/

# Ad-hoc debug screenshots dropped at the repo root. Anchored to root so that
# curated documentation images under docs/images/ are still tracked.
/*.png
/*.jpg
/*.jpeg

# Scratch artifacts
rdap.json
**/test-output.txt
**/test_output*.txt
**/eslint-output.json
/seed-logs/
/scripts/seed-logs/

# Playwright storage state: real signed JWTs, regenerated by auth.setup.ts
e2e/.auth/

# Agent permission allowlists record full shell command lines, which has
# captured inline credentials before. Never track these.
.claude/settings.local.json
.claude/*.local.md

# The bare .env rule misses these
.env.production
.env.staging
.env.test

# Playwright CLI page dumps: raw captures of authenticated pages
.playwright-cli/

# Playwright run artifacts (reports embed traces/network logs from authenticated sessions)
e2e/playwright-report/
e2e/test-results/
mobile/playwright-report/
mobile/test-results/
