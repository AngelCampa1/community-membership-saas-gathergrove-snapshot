{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "GatherGrove Typography Tokens",
  "description": "Font sizes, weights, families, and line-heights. Rem values for web.",

  "typography": {
    "fontFamily": {
      "sans":  { "value": "var(--font-geist-sans), ui-sans-serif, system-ui, -apple-system, sans-serif", "type": "fontFamily" },
      "mono":  { "value": "var(--font-geist-mono), ui-monospace, 'Cascadia Code', monospace", "type": "fontFamily" }
    },

    "fontSize": {
      "xs":   { "value": "0.75rem",  "type": "fontSize", "lineHeight": "1rem",   "mobile": 12 },
      "sm":   { "value": "0.875rem", "type": "fontSize", "lineHeight": "1.25rem","mobile": 14 },
      "base": { "value": "1rem",     "type": "fontSize", "lineHeight": "1.5rem", "mobile": 16 },
      "lg":   { "value": "1.125rem", "type": "fontSize", "lineHeight": "1.75rem","mobile": 18 },
      "xl":   { "value": "1.25rem",  "type": "fontSize", "lineHeight": "1.75rem","mobile": 20 },
      "2xl":  { "value": "1.5rem",   "type": "fontSize", "lineHeight": "2rem",   "mobile": 24 },
      "3xl":  { "value": "1.875rem", "type": "fontSize", "lineHeight": "2.25rem","mobile": 30 },
      "4xl":  { "value": "2.25rem",  "type": "fontSize", "lineHeight": "2.5rem", "mobile": 36 },
      "5xl":  { "value": "3rem",     "type": "fontSize", "lineHeight": "1",      "mobile": 48 },
      "6xl":  { "value": "3.75rem",  "type": "fontSize", "lineHeight": "1",      "mobile": 60 },
      "7xl":  { "value": "4.5rem",   "type": "fontSize", "lineHeight": "1",      "mobile": 72 },
      "8xl":  { "value": "6rem",     "type": "fontSize", "lineHeight": "1",      "mobile": 96 },
      "9xl":  { "value": "8rem",     "type": "fontSize", "lineHeight": "1",      "mobile": 128 }
    },

    "fontWeight": {
      "thin":       { "value": "100", "type": "fontWeight" },
      "extralight": { "value": "200", "type": "fontWeight" },
      "light":      { "value": "300", "type": "fontWeight" },
      "normal":     { "value": "400", "type": "fontWeight" },
      "medium":     { "value": "500", "type": "fontWeight" },
      "semibold":   { "value": "600", "type": "fontWeight" },
      "bold":       { "value": "700", "type": "fontWeight" },
      "extrabold":  { "value": "800", "type": "fontWeight" },
      "black":      { "value": "900", "type": "fontWeight" }
    },

    "lineHeight": {
      "none":    { "value": "1",     "type": "lineHeight" },
      "tight":   { "value": "1.25",  "type": "lineHeight" },
      "snug":    { "value": "1.375", "type": "lineHeight" },
      "normal":  { "value": "1.5",   "type": "lineHeight" },
      "relaxed": { "value": "1.625", "type": "lineHeight" },
      "loose":   { "value": "2",     "type": "lineHeight" }
    }
  }
}
