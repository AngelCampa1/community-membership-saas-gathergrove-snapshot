{
  "name": "gathergrove-deployment-tests",
  "version": "1.0.0",
  "description": "Comprehensive deployment verification test suite for GatherGrove",
  "main": "index.js",
  "scripts": {
    "test": "npm run test:deployment",
    "test:deployment": "jest tests/deployment --verbose",
    "test:deployment-verification": "jest tests/deployment/deployment-verification.test.ts --verbose",
    "test:production-readiness": "jest tests/deployment/production-readiness.test.ts --verbose",
    "test:functionality": "jest tests/deployment/real-functionality-validation.test.ts --verbose",
    "test:dependencies": "jest tests/deployment/service-dependency-tests.test.ts --verbose",
    "test:user-journeys": "jest tests/deployment/critical-user-journey-validation.test.ts --verbose",
    "test:all-deployment": "npm run test:deployment",
    "test:staging": "TEST_ENVIRONMENT=staging npm run test:deployment",
    "test:production": "TEST_ENVIRONMENT=production npm run test:deployment",
    "test:quick": "jest tests/deployment/deployment-verification.test.ts --testNamePattern='Basic Service Availability|Database Connectivity'",
    "test:critical": "jest tests/deployment/critical-user-journey-validation.test.ts",
    "test:performance": "jest tests/performance --verbose",
    "test:security": "jest tests/security --verbose",
    "test:e2e": "jest tests/e2e --verbose",
    "test:integration": "jest tests/integration --verbose"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@playwright/test": "^1.60.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.12.7",
    "@types/supertest": "^6.0.3",
    "axios": "^1.16.1",
    "axios-mock-adapter": "^2.1.0",
    "express": "^5.2.1",
    "jest": "^29.7.0",
    "jsonwebtoken": "^9.0.2",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "testMatch": [
      "**/deployment/**/*.test.ts",
      "**/deployment/**/*.test.js"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/../client/src/$1",
      "^@/services/(.*)$": "<rootDir>/../client/src/services/$1",
      "^@/types/(.*)$": "<rootDir>/../client/src/types/$1",
      "^@/lib/(.*)$": "<rootDir>/../client/src/lib/$1",
      "^@/hooks/(.*)$": "<rootDir>/../client/src/hooks/$1",
      "^@/components/(.*)$": "<rootDir>/../client/src/components/$1"
    },
    "collectCoverage": false,
    "verbose": true,
    "testTimeout": 60000,
    "maxWorkers": "50%",
    "testSequencer": "<rootDir>/jest.sequencer.js",
    "passWithNoTests": true,
    "cache": true
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/gathergrove.git"
  },
  "keywords": [
    "deployment",
    "testing",
    "verification",
    "e2e",
    "integration",
    "performance",
    "security"
  ],
  "author": "GatherGrove Team",
  "license": "MIT"
}
