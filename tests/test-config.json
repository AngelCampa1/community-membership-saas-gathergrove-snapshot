{
  "testCategories": {
    "integration": {
      "description": "Integration tests for component interactions and API integrations",
      "framework": "Jest + React Testing Library",
      "coverage": {
        "threshold": 85,
        "exclude": ["__tests__", "*.d.ts", "node_modules"]
      }
    },
    "security": {
      "description": "Security validation tests for authentication, authorization, and vulnerability prevention",
      "framework": "Jest + Supertest",
      "coverage": {
        "threshold": 90,
        "focus": ["auth", "validation", "sanitization"]
      }
    },
    "performance": {
      "description": "Performance tests for database operations, API response times, and resource usage",
      "framework": "Jest + Node.js Performance API",
      "thresholds": {
        "databaseConnection": "< 5000ms",
        "apiResponse": "< 500ms",
        "memoryUsage": "< 100MB increase",
        "concurrentOperations": "50+ simultaneous"
      }
    },
    "e2e": {
      "description": "End-to-end tests for critical user journeys across the entire application",
      "framework": "Playwright",
      "browsers": ["chromium", "firefox", "webkit"],
      "viewports": {
        "mobile": {"width": 375, "height": 667},
        "tablet": {"width": 768, "height": 1024},
        "desktop": {"width": 1280, "height": 720}
      }
    },
    "regression": {
      "description": "Regression tests for previously fixed production issues",
      "framework": "Jest",
      "focus": [
        "custom domain routing",
        "responsive design fixes", 
        "database timeout handling",
        "security enhancements",
        "performance optimizations"
      ]
    },
    "load": {
      "description": "Load tests for payment processing and high-traffic scenarios",
      "framework": "Jest + Custom Load Testing",
      "scenarios": {
        "concurrentPayments": 50,
        "subscriptionRenewals": 100,
        "webhookProcessing": 200,
        "databaseWrites": 75
      }
    },
    "contract": {
      "description": "API contract tests ensuring consistent request/response formats",
      "framework": "Jest + Schema Validation",
      "endpoints": [
        "Authentication API",
        "Members API", 
        "Events API",
        "Payment API",
        "Dashboard API"
      ]
    },
    "visual": {
      "description": "Visual regression tests for UI consistency across components and themes",
      "framework": "Playwright + Screenshots",
      "components": [
        "Landing page sections",
        "Authentication forms",
        "Admin dashboard",
        "Member interface", 
        "Mobile responsive views",
        "Light-Only Mode variations"
      ]
    }
  },
  "testEnvironments": {
    "unit": {
      "testEnvironment": "jest-environment-jsdom",
      "setupFiles": ["jest.setup.js"],
      "moduleNameMapper": {
        "^@/(.*)$": "<rootDir>/src/$1"
      }
    },
    "integration": {
      "testEnvironment": "jest-environment-node",
      "setupFiles": ["jest.setup.js", "integration.setup.js"]
    },
    "e2e": {
      "testDir": "./tests/e2e",
      "use": {
        "baseURL": "http://localhost:3000",
        "trace": "on-first-retry",
        "screenshot": "only-on-failure"
      }
    }
  },
  "coverageThresholds": {
    "global": {
      "branches": 80,
      "functions": 80,
      "lines": 80,
      "statements": 80
    },
    "critical": {
      "auth": 95,
      "payments": 95,
      "security": 95
    }
  },
  "testPatterns": {
    "unit": ["**/*.test.{js,ts,jsx,tsx}", "**/__tests__/**/*.{js,ts,jsx,tsx}"],
    "integration": ["tests/integration/**/*.test.{js,ts,jsx,tsx}"],
    "e2e": ["tests/e2e/**/*.test.{js,ts}"],
    "performance": ["tests/performance/**/*.test.{js,ts}"],
    "security": ["tests/security/**/*.test.{js,ts}"],
    "load": ["tests/load/**/*.test.{js,ts}"],
    "contract": ["tests/contract/**/*.test.{js,ts}"],
    "visual": ["tests/visual/**/*.test.{js,ts}"],
    "regression": ["tests/regression/**/*.test.{js,ts}"]
  },
  "reportingConfig": {
    "formats": ["html", "lcov", "text", "cobertura"],
    "outputDirectory": "coverage",
    "includeUncoveredFiles": true,
    "collectCoverageFrom": [
      "src/**/*.{js,ts,jsx,tsx}",
      "!src/**/*.d.ts",
      "!src/**/__tests__/**",
      "!src/**/__mocks__/**"
    ]
  },
  "cicdIntegration": {
    "testStages": {
      "commit": ["unit", "integration"],
      "pullRequest": ["unit", "integration", "security", "contract"],
      "staging": ["unit", "integration", "e2e", "performance", "visual"],
      "production": ["regression", "load", "security"]
    },
    "parallelExecution": {
      "enabled": true,
      "maxWorkers": "50%",
      "testSuites": [
        "unit",
        "integration", 
        "security",
        "performance"
      ]
    }
  },
  "testData": {
    "fixtures": {
      "users": "tests/fixtures/users.json",
      "members": "tests/fixtures/members.json", 
      "events": "tests/fixtures/events.json",
      "payments": "tests/fixtures/payments.json"
    },
    "mocks": {
      "stripe": "tests/mocks/stripe.js",
      "azure": "tests/mocks/azure-communication.js",
      "database": "tests/mocks/database.js"
    }
  },
  "qualityGates": {
    "minimumCoverage": 80,
    "maxFailures": 0,
    "performanceThresholds": {
      "pageLoadTime": 3000,
      "apiResponseTime": 500,
      "databaseQueryTime": 200
    },
    "securityChecks": [
      "SQL injection prevention",
      "XSS sanitization",
      "CSRF protection",
      "Authentication validation",
      "Authorization enforcement"
    ]
  }
}