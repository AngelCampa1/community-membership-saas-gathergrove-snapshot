# GatherGrove Production Environment Variables Template
# Copy this file to .env.production and fill in the actual production values
# DO NOT commit .env.production to source control - use Azure Key Vault instead

# =============================================================================
# AZURE CONFIGURATION
# =============================================================================
# Azure Service Principal for Key Vault access
AZURE_CLIENT_ID=your-service-principal-client-id
AZURE_CLIENT_SECRET=your-service-principal-client-secret
AZURE_TENANT_ID=your-azure-tenant-id
AZURE_SUBSCRIPTION_ID=your-azure-subscription-id

# Azure Key Vault URL
AZURE_KEY_VAULT_URL=https://gathergrove-keyvault-v2.vault.azure.net/

# =============================================================================
# APPLICATION ENVIRONMENT
# =============================================================================
# Set the environment to production
ASPNETCORE_ENVIRONMENT=Production
NODE_ENV=production

# Enable HTTPS enforcement
ASPNETCORE_HTTPS_PORT=443
REQUIRE_HTTPS=true

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# Azure SQL Database connection string (retrieve from Key Vault in production)
CONNECTION_STRING=Server=tcp:your-server.database.windows.net,1433;Database=GatherGroveDb_Prod;User ID=your-username;Password=your-password;Trusted_Connection=False;Encrypt=True;Connection Timeout=30;

# =============================================================================
# AUTHENTICATION & SECURITY
# =============================================================================
# JWT Secret Key (minimum 256 bits, retrieve from Key Vault in production)
JWT_SECRET_KEY=your-super-secure-jwt-secret-key-minimum-256-bits-long

# Security settings
Security__RateLimitPerMinute=1000
Security__EnableXssProtection=true
Security__EnableSqlInjectionProtection=true
Security__EnableSecurityHeaders=true
Security__EnableHsts=true

# =============================================================================
# STRIPE PAYMENT PROCESSING
# =============================================================================
# Stripe Production Keys (retrieve from Key Vault in production)
STRIPE_SECRET_KEY=sk_live_your_production_secret_key
STRIPE_PUBLISHABLE_KEY=pk_live_your_production_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_production_webhook_secret

# Stripe Price IDs for production
STRIPE_GROW_WEEKLY_PRICE_ID=price_production_grow_weekly
STRIPE_GROW_MONTHLY_PRICE_ID=price_production_grow_monthly
STRIPE_UNLIMITED_WEEKLY_PRICE_ID=price_production_unlimited_weekly
STRIPE_UNLIMITED_MONTHLY_PRICE_ID=price_production_unlimited_monthly

# =============================================================================
# FRONTEND CONFIGURATION
# =============================================================================
# API Base URLs for production
NEXT_PUBLIC_API_BASE_URL=https://api.gathergrove.club/api/v1
API_BASE_URL=https://api.gathergrove.club

# Frontend URLs
App__FrontendUrl=https://gathergrove.club
App__ApiUrl=https://api.gathergrove.club

# Public keys that can be exposed to the frontend
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your_production_publishable_key
NEXT_PUBLIC_STRIPE_GROW_WEEKLY_PRICE_ID=price_production_grow_weekly
NEXT_PUBLIC_STRIPE_GROW_MONTHLY_PRICE_ID=price_production_grow_monthly
NEXT_PUBLIC_STRIPE_UNLIMITED_WEEKLY_PRICE_ID=price_production_unlimited_weekly
NEXT_PUBLIC_STRIPE_UNLIMITED_MONTHLY_PRICE_ID=price_production_unlimited_monthly
NEXT_PUBLIC_STRIPE_GROW_PRICE_ID=price_production_grow_monthly

# Environment flags
NEXT_PUBLIC_NODE_ENV=production
NEXT_PUBLIC_DEBUG=false

# =============================================================================
# MOBILE CONFIGURATION
# =============================================================================
# Mobile API configuration
API_BASE_URL=https://api.gathergrove.club

# Mobile environment
EXPO_ENV=production
EXPO_PROJECT_ID=your-expo-project-id

# Mobile app identifiers
IOS_BUNDLE_IDENTIFIER=com.gathergrove.app
ANDROID_PACKAGE=com.gathergrove.app

# App Store configuration
APP_VERSION=1.0.0
BUILD_NUMBER=1
TARGET_SDK_VERSION=34

# =============================================================================
# AZURE COMMUNICATION SERVICES
# =============================================================================
# Email and SMS services (retrieve from Key Vault in production)
ACS__ConnectionString=endpoint=https://your-acs.communication.azure.com/;accesskey=your-access-key
ACS__EmailFromAddress=noreply@gathergrove.club
ACS__SmsFromNumber=+1234567890

# ACS Feature flags
ACS__EnableEmail=true
ACS__EnableSms=true

# =============================================================================
# MONITORING & OBSERVABILITY
# =============================================================================
# Application Insights (retrieve from Key Vault in production)
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=your-instrumentation-key;IngestionEndpoint=https://your-region.in.applicationinsights.azure.com/
NEXT_PUBLIC_APPLICATION_INSIGHTS_CONNECTION_STRING=InstrumentationKey=your-instrumentation-key;IngestionEndpoint=https://your-region.in.applicationinsights.azure.com/

# Google Analytics (optional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# =============================================================================
# CACHING & PERFORMANCE
# =============================================================================
# Redis Cache (retrieve password from Key Vault in production)
REDIS_PASSWORD=your-secure-redis-password
ConnectionStrings__Redis=your-redis-connection-string

# Cache settings
Caching__DefaultExpirationMinutes=30
Caching__EnableResponseCaching=true
Caching__EnableMemoryCache=true
Caching__EnableRedisCache=true

# =============================================================================
# PUSH NOTIFICATIONS (MOBILE)
# =============================================================================
# Azure Notification Hub configuration
AZURE_NOTIFICATION_HUB_CONNECTION_STRING=Endpoint=sb://your-namespace.servicebus.windows.net/;SharedAccessKeyName=DefaultFullSharedAccessSignature;SharedAccessKey=your-key
AZURE_NOTIFICATION_HUB_NAME=gathergrove-notifications-prod

# Firebase configuration (optional)
GOOGLE_ANALYTICS_TRACKING_ID=your-ga-tracking-id
FIREBASE_PROJECT_ID=your-firebase-project

# =============================================================================
# SSL/TLS CONFIGURATION
# =============================================================================
# SSL Certificate configuration
CERT_PASSWORD=your-ssl-certificate-password
CERT_PATH=/etc/ssl/certs/gathergrove.pfx

# =============================================================================
# FEATURE FLAGS
# =============================================================================
# Backend feature flags
App__IsDevelopmentMode=false
App__RequireHttps=true
App__EnableSwagger=false
App__EnableDetailedErrors=false

# Frontend feature flags
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_PUSH_NOTIFICATIONS=true
NEXT_PUBLIC_ENABLE_OFFLINE_MODE=false
NEXT_PUBLIC_ENABLE_SECURITY_HEADERS=true

# Mobile feature flags
ENABLE_PUSH_NOTIFICATIONS=true
ENABLE_BIOMETRIC_AUTH=true
ENABLE_OFFLINE_MODE=true
ENABLE_CRASH_REPORTING=true
ENABLE_SSL_PINNING=true
ENABLE_CERTIFICATE_VALIDATION=true
ENABLE_DEBUGGING=false
ENABLE_PERFORMANCE_MONITORING=true

# =============================================================================
# CORS CONFIGURATION
# =============================================================================
# Allowed origins for CORS
Cors__AllowedOrigins__0=https://gathergrove.club
Cors__AllowedOrigins__1=https://www.gathergrove.club
Cors__AllowedOrigins__2=https://app.gathergrove.club

# =============================================================================
# RATE LIMITING
# =============================================================================
# Rate limit configuration
RateLimit__WellKnown__MaxRequests=5
RateLimit__WellKnown__WindowMinutes=60
RateLimit__General__MaxRequests=10000
RateLimit__General__WindowMinutes=60
RateLimit__Authentication__MaxRequests=100
RateLimit__Authentication__WindowMinutes=60
RateLimit__Payment__MaxRequests=50
RateLimit__Payment__WindowMinutes=60

# =============================================================================
# DATABASE PERFORMANCE
# =============================================================================
# Database optimization settings
Database__ConnectionTimeout=30
Database__CommandTimeout=60
Database__EnableRetryOnFailure=true
Database__MaxRetryCount=3
Database__MaxRetryDelay=00:00:30
Database__EnableSensitiveDataLogging=false
Database__EnableDetailedErrors=false

# =============================================================================
# FILE UPLOAD CONFIGURATION
# =============================================================================
# File handling settings
Files__MaxFileSizeBytes=10485760
Files__StorageProvider=Azure
Files__EnableVirusScanning=true

# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================
# Email service settings
Email__DefaultFromName=GatherGrove
Email__EnableTemplateRendering=true
Email__MaxRecipientsPerEmail=50
Email__EnableBatchSending=true

# =============================================================================
# CDN CONFIGURATION (OPTIONAL)
# =============================================================================
# CDN URL for static assets
NEXT_PUBLIC_CDN_URL=https://cdn.gathergrove.club

# =============================================================================
# DEPLOYMENT METADATA
# =============================================================================
# Build information (typically set by CI/CD)
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_BUILD_ID=production
PERFORMANCE_SAMPLE_RATE=0.1

# =============================================================================
# HEALTH CHECK CONFIGURATION
# =============================================================================
# Health check settings
HealthChecks__TimeoutSeconds=10
HealthChecks__DetailedOutput=false
HealthChecks__EnableDatabaseCheck=true
HealthChecks__EnableExternalServiceChecks=true

# =============================================================================
# IMPORTANT SECURITY NOTES
# =============================================================================
# 1. Never commit this file with actual values to source control
# 2. Use Azure Key Vault references in production appsettings.json
# 3. Set up proper secret rotation policies
# 4. Use managed identities where possible
# 5. Enable audit logging for all secret access
# 6. Regularly review and update security configurations
# 7. Use different secrets for staging and production environments
# 8. Implement proper backup and disaster recovery procedures