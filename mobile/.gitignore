# React Native specific
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Expo
.expo/

# Metro
.metro-health-check*

# Native folders (CNG - Continuous Native Generation)
# These are generated by `npx expo prebuild` and should not be committed
# Azure Pipelines / EAS Build will regenerate them during the build process
/android/
/ios/
# Exception: Keep ExportOptions plists for Azure Pipeline iOS builds
!/ios/ExportOptions-*.plist

# Store credentials (backup gitignore - also in .gitignore)
*.keystore
!debug.keystore

# macOS
.DS_Store

# Temporary files
*.tmp
*.temp

# IDE
.vscode/
.idea/

# Testing
coverage/
*.lcov

# TypeScript
*.tsbuildinfo

# Environment variables
.env
.env.local
.env.production

# Store credentials (NEVER commit)
google-service-account.json
google-services.json
*.p8
*.mobileprovision
*.cer

# Logs
logs
*.log

# Build outputs
dist/
build/
*.txt
