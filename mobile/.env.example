# GatherGrove Mobile - Environment Configuration
# Copy this file to .env.local and update with your values
# Production secrets are stored in Azure Key Vault: kv-ventora-shared

# ===========================================
# APP CONFIGURATION
# ===========================================
APP_ENV=development
APP_VERSION=1.0.0
BUILD_NUMBER=1

# API Configuration
# Development: http://localhost:8050
# Production: https://api.gathergrove.club
API_BASE_URL=http://localhost:8050

# For physical device testing, use your computer's IP address:
# API_BASE_URL=http://192.168.1.100:8050

# ===========================================
# EXPO / EAS CONFIGURATION
# ===========================================
# Get this from: https://expo.dev/accounts/[account]/projects/[project]/overview
EXPO_PROJECT_ID=your-expo-project-id

# ===========================================
# AZURE CONFIGURATION
# ===========================================
# Resource Group: rg-shared-projects
# Key Vault: kv-ventora-shared (https://kv-ventora-shared.vault.azure.net/)

# Azure Notification Hub (for push notifications)
# Create in Azure Portal or use existing hub
AZURE_NOTIFICATION_HUB_CONNECTION_STRING=
AZURE_NOTIFICATION_HUB_NAME=gathergrove-notifications

# Application Insights: appi-gathergrove
# Instrumentation Key: 00000000-0000-0000-0000-000000000000
# Get connection string from Key Vault secret: AppInsights-GatherGrove-ConnectionString
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=your-instrumentation-key-here;IngestionEndpoint=https://eastus-8.in.applicationinsights.azure.com/

# ===========================================
# GOOGLE SSO CONFIGURATION
# ===========================================
# Get these from: https://console.cloud.google.com/apis/credentials
# Create OAuth 2.0 Client IDs for iOS, Android, and Web
GOOGLE_WEB_CLIENT_ID=REPLACE_WITH_GOOGLE_WEB_CLIENT_ID.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_ID=REPLACE_WITH_GOOGLE_IOS_CLIENT_ID.apps.googleusercontent.com
GOOGLE_ANDROID_CLIENT_ID=REPLACE_WITH_GOOGLE_ANDROID_CLIENT_ID.apps.googleusercontent.com

# ===========================================
# APPLE SSO CONFIGURATION
# ===========================================
# Configured in Apple Developer Portal
# Bundle ID: com.gathergrove.mobile
# Sign in with Apple capability must be enabled

# ===========================================
# STORE SUBMISSION CREDENTIALS
# ===========================================
# Apple App Store Connect (update in eas.json)
# - Apple ID: your-apple-id@email.com
# - ASC App ID: Get from App Store Connect after creating app
# - Apple Team ID: Get from Apple Developer Portal

# Google Play Console
# - Create service account at: https://console.cloud.google.com/iam-admin/serviceaccounts
# - Download JSON key and save as: ./google-service-account.json
# - Grant access in Google Play Console > Settings > API access

# ===========================================
# TESTING CONFIGURATION
# ===========================================
TEST_API_BASE_URL=http://localhost:8050
EXPO_WEB_URL=http://localhost:8081