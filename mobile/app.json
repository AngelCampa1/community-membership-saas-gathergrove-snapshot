{
  "expo": {
    "name": "GatherGrove Mobile",
    "slug": "gathergrove-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/AppIcon-ios-1024x1024.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/splash-default.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/images/AppIcon-ios-1024x1024.png",
      "bundleIdentifier": "com.gathergrove.mobile",
      "usesAppleSignIn": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/AppIcon-android-512x512.png",
        "backgroundColor": "#10b981"
      },
      "icon": "./assets/images/AppIcon-android-512x512.png",
      "package": "com.gathergrove.mobile"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./public/favicon.ico",
      "build": {
        "minify": true,
        "mode": "production"
      },
      "config": {
        "firebase": {
          "measurementId": "G-XXXXXXXXXX"
        }
      },
      "meta": {
        "title": "GatherGrove Mobile - Club Management Made Simple",
        "description": "Powerful club management platform for community organizations. Manage members, events, communications, and finances with ease.",
        "keywords": "club management, community organization, member management, event planning, nonprofit software",
        "author": "GatherGrove",
        "viewport": "width=device-width, initial-scale=1.0, viewport-fit=cover",
        "themeColor": "#10b981",
        "backgroundColor": "#ffffff",
        "appleWebApp": {
          "capable": true,
          "statusBarStyle": "default",
          "title": "GatherGrove"
        },
        "openGraph": {
          "type": "website",
          "title": "GatherGrove Mobile - Club Management Made Simple",
          "description": "Powerful club management platform for community organizations.",
          "image": "./assets/images/og-image.png",
          "url": "https://gathergrove.club"
        },
        "twitter": {
          "card": "summary_large_image",
          "title": "GatherGrove Mobile",
          "description": "Powerful club management platform for community organizations.",
          "image": "./assets/images/twitter-card.png"
        }
      },
      "performance": {
        "inlineSourceMap": false,
        "minifyHTML": true,
        "minifyCSS": true,
        "minifyJS": true,
        "optimizeImages": true,
        "generateServiceWorker": true,
        "precacheManifest": true,
        "bundleAnalyzer": false
      }
    },
    "plugins": [
      "expo-font",
      "expo-asset",
      "expo-apple-authentication",
      "@react-native-google-signin/google-signin"
    ],
    "scheme": "gathergrove",
    "extra": {
      "_comment": "Environment configuration - see app.config.ts for dynamic config",
      "development": {
        "apiBaseUrl": "http://localhost:8050",
        "_customApiNote": "For physical device testing, update this to your computer's IP (e.g., 'http://192.168.1.100:8050')"
      },
      "production": {
        "apiBaseUrl": "https://api.gathergrove.club"
      },
      "sso": {
        "_comment": "SSO Configuration - set via environment variables in .env.local",
        "googleIosClientId": "",
        "googleAndroidClientId": "",
        "googleWebClientId": ""
      },
      "eas": {
        "projectId": "00000000-0000-0000-0000-000000000000"
      }
    }
  }
}
