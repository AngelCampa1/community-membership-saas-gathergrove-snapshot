{
  "name": "gathergrove-mobile",
  "version": "0.1.0",
  "private": true,
  "license": "ISC",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build": "expo build",
    "build:e2e": "expo export",
    "build:web": "npm run typecheck && npm run lint && expo export --platform web",
    "build:web:e2e": "expo export:web",
    "build:production": "NODE_ENV=production npm run build:web && npm run analyze-bundle",
    "audit:lighthouse": "lighthouse http://localhost:19006 --only-categories=performance,accessibility,best-practices,seo --output=json --output-path=./lighthouse-results.json",
    "audit:lighthouse:ci": "npm run build:production && npm start & sleep 10 && npm run audit:lighthouse && kill %1",
    "perf:audit": "npm run audit:lighthouse && node scripts/performance-audit.js",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e-headed": "playwright test --headed",
    "test:e2e-ui": "playwright test --ui",
    "test:mobile": "npm run test && npm run test:e2e",
    "test:setup": "node scripts/mobile-test-setup.js",
    "test:production": "NODE_ENV=production npm run test",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch",
    "check-versions": "node scripts/check-versions.js",
    "analyze-bundle": "node scripts/bundle-analyzer.js",
    "generate-icons": "node generate-icons.js",
    "mobile-setup": "npm run test:setup",
    "clean": "rm -rf node_modules/.cache .expo build web-build",
    "reset": "npm run clean && npm install",
    "validate": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "@expo/cli": "54.0.24",
    "@expo/metro-runtime": "~6.1.2",
    "@microsoft/signalr": "^8.0.7",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "^11.4.1",
    "@react-native-community/slider": "5.0.1",
    "@react-native-google-signin/google-signin": "^16.0.0",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "@react-navigation/native": "^6.1.10",
    "@react-navigation/native-stack": "^6.9.18",
    "@sentry/react-native": "^8.4.0",
    "@stripe/stripe-react-native": "0.50.3",
    "axios": "^1.16.1",
    "expo": "~54.0.34",
    "expo-apple-authentication": "~8.0.8",
    "expo-camera": "~17.0.10",
    "expo-dev-client": "~6.0.20",
    "expo-haptics": "~15.0.8",
    "expo-notifications": "~0.32.14",
    "expo-secure-store": "^15.0.8",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-device-info": "^15.0.1",
    "react-native-keychain": "^8.2.0",
    "react-native-qrcode-svg": "^6.3.15",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-vector-icons": "^10.0.3",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/preset-env": "^7.20.0",
    "@babel/runtime": "^7.20.0",
    "@mswjs/interceptors": "^0.40.0",
    "@playwright/test": "^1.55.0",
    "@react-native/eslint-config": "^0.81.6",
    "@react-native/typescript-config": "^0.81.6",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^12.4.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.0",
    "@types/react-native-vector-icons": "^6.4.18",
    "@types/react-test-renderer": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "@vue/preload-webpack-plugin": "^2.0.0",
    "axios-mock-adapter": "^2.1.0",
    "babel-jest": "^29.6.3",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-plugin-transform-react-remove-prop-types": "^0.4.24",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "babel-preset-expo": "~54.0.0",
    "compression-webpack-plugin": "^12.0.0",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "eslint": "^8.56.0",
    "file-loader": "^6.2.0",
    "html-webpack-inline-source-plugin": "^1.0.0-beta.2",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.1.1",
    "lighthouse": "^12.8.2",
    "mini-css-extract-plugin": "^2.9.0",
    "msw": "^2.12.4",
    "prettier": "2.8.8",
    "react-test-renderer": "19.1.0",
    "sharp": "^0.34.4",
    "typescript": "~5.9.2",
    "url-loader": "^4.1.1",
    "web-streams-polyfill": "^4.2.0",
    "webpack-bundle-analyzer": "^4.10.0",
    "whatwg-fetch": "^3.6.20",
    "workbox-webpack-plugin": "^7.4.1"
  },
  "overrides": {
    "@babel/plugin-transform-modules-systemjs": "^7.29.4",
    "@eslint/eslintrc": {
      "ajv": "^6.12.6"
    },
    "eslint": {
      "ajv": "^6.12.6"
    },
    "@isaacs/brace-expansion": "^5.0.6",
    "test-exclude": {
      "minimatch": "^3.0.4"
    },
    "@xmldom/xmldom": "^0.8.13",
    "ajv": "^8.20.0",
    "fast-xml-parser": "^5.7.0",
    "minimatch": "^10.2.5",
    "picomatch": "^4.0.4",
    "rollup": "^4.53.3",
    "serialize-javascript": "^7.0.5",
    "svgo": "^4.0.1",
    "tar": "^7.5.11",
    "undici": "^6.24.0",
    "ws": "^8.21.0",
    "yaml": "^2.9.0"
  },
  "engines": {
    "node": ">=18"
  }
}
