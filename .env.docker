# Environment variables for Docker compose
# This file contains environment variables for Docker containers
# Copy this file to .env in the root directory and set your values

# SQL Server Configuration
SA_PASSWORD_SECRET=${SA_PASSWORD:-SecureRandomPassword123!}

# JWT Configuration
JWT_SECRET_KEY=${JWT_SECRET_KEY:-your-very-secure-jwt-secret-key-at-least-32-characters-long}

# Development Settings
USE_INMEMORY_DB=${USE_INMEMORY_DB:-false}
ASPNETCORE_ENVIRONMENT=${ASPNETCORE_ENVIRONMENT:-Development}

# Security Configuration
REQUIRE_HTTPS=${REQUIRE_HTTPS:-true}