{
  "_readme": "PRODUCTION CONFIGURATION TEMPLATE - Copy to appsettings.Production.json and fill in values",
  "BackgroundJobs": {
    "Enabled": true,
    "ScheduledCommunicationsInterval": "00:05:00",
    "_comment": "Process scheduled communications every 5 minutes"
  },
  "Communications": {
    "Mock": {
      "Enabled": false,
      "LogToConsole": false,
      "_comment": "DISABLE mock mode in production!"
    },
    "EmailTracking": {
      "BaseUrl": "https://yourdomain.com",
      "_comment": "Production domain for tracking pixels"
    },
    "Compliance": {
      "RequireUnsubscribeLink": true,
      "UnsubscribeUrl": "https://yourdomain.com/unsubscribe",
      "CompanyName": "Your Company Name",
      "CompanyPhysicalAddress": "123 Main St, City, State 12345",
      "_comment": "REQUIRED for CAN-SPAM Act compliance"
    },
    "RateLimiting": {
      "EmailsPerMinute": 100,
      "_comment": "Adjust based on your email provider limits"
    }
  },
  "Logging": {
    "LogLevel": {
      "GatherGrove.Application.Services.CommunicationSchedulerService": "Information",
      "GatherGrove.Application.Services.ABTestingService": "Information"
    }
  }
}
