{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=GatherGroveDb;Username=postgres;Password=postgres;Timeout=30;Command Timeout=60"
  },
  "JwtSettings": {
    "SecretKey": "",
    "Comment": "🔐 REQUIRED: Set JWT_SECRET_KEY in .env file (development) or Azure Key Vault (production). Generate with: [Convert]::ToBase64String((1..32 | %{Get-Random -Max 256}))",
    "Issuer": "GatherGrove",
    "Audience": "GatherGrove",
    "ExpiryMinutes": "60"
  },
  "App": {
    "FrontendUrl": "http://localhost:3050",
    "ApiUrl": "http://localhost:8050",
    "WebsiteUrl": "http://localhost:3000"
  },
  "TrustedProxy": false,
  "Turnstile": {
    "SiteKey": "",
    "SecretKey": "",
    "Comment": "Set TURNSTILE_SITE_KEY and TURNSTILE_SECRET_KEY in production. The API fails closed when the production secret is missing."
  },
  "CorsSettings": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "https://localhost:3000",
      "http://localhost:3050",
      "https://localhost:3050"
    ],
    "AllowedMobileOrigins": [
      "http://localhost:8081",
      "http://localhost:8082",
      "http://127.0.0.1:8081",
      "http://127.0.0.1:8082",
      "http://10.0.2.2:8081",
      "http://10.0.2.2:8082"
    ],
    "AllowedProductionOrigins": [
      "https://gathergrove-staging.azurewebsites.net",
      "https://staging.gathergrove.club",
      "https://gathergrove.club",
      "https://www.gathergrove.club"
    ]
  },
  "Stripe": {
    "SecretKey": "",
    "Comment_SecretKey": "🔐 REQUIRED: Get from https://dashboard.stripe.com/apikeys (use sk_test_ for dev, sk_live_ for prod)",
    "PublishableKey": "",
    "Comment_PublishableKey": "🔐 REQUIRED: Get from https://dashboard.stripe.com/apikeys (safe to expose in frontend)",
    "WebhookSecret": "",
    "Comment_WebhookSecret": "🔐 REQUIRED: Get from https://dashboard.stripe.com/webhooks after setting up /api/v1/billing/webhook",
    "Comment_PriceIds": "⚠️ REQUIRED: Replace placeholder price IDs with real Stripe Price IDs after completing Phase 0 (Stripe Dashboard setup)",
    "GrowMonthlyPriceId": "price_GROW_MONTHLY_NEW",
    "GrowAnnualPriceId": "price_GROW_ANNUAL",
    "UnlimitedMonthlyPriceId": "price_UNLIMITED_MONTHLY",
    "UnlimitedAnnualPriceId": "price_UNLIMITED_ANNUAL",
    "SeedMonthlyPriceId": "price_SEED_MONTHLY",
    "SeedAnnualPriceId": "price_SEED_ANNUAL",
    "IsConnectEnabled": true,
    "DefaultCountry": "US",
    "PlatformCountry": "US"
  },
  "Resend": {
    "ApiToken": "",
    "Comment_ApiToken": "🔐 REQUIRED: Get from https://resend.com/api-keys",
    "FromEmailAddress": "noreply@gathergrove.club",
    "FromName": "Angel Campa",
    "VentoraLabsFromAddress": "noreply@ventoralabs.com",
    "VentoraLabsFromName": "Ventora Labs",
    "WebhookSecret": "",
    "Comment_WebhookSecret": "🔐 REQUIRED: Get from Resend webhook settings for signature verification",
    "AdminEmailAddress": "noreply@gathergrove.club",
    "Comment_AdminEmailAddress": "📧 Email address for forwarding all inbound @gathergrove.club emails"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Hosting": "Warning",
      "Microsoft.Extensions.Http": "Warning",
      "GatherGrove.API.Middleware.RequestLoggingMiddleware": "Information",
      "GatherGrove.API.Middleware.DatabaseLoggingInterceptor": "Information",
      "GatherGrove.API.Middleware.GlobalExceptionMiddleware": "Information",
      "GatherGrove.API.Middleware.RateLimitingMiddleware": "Information"
    },
    "Console": {
      "IncludeScopes": true,
      "TimestampFormat": "yyyy-MM-dd HH:mm:ss.fff zzz "
    }
  },
  "Sentry": {
    "Dsn": "",
    "Comment": "🔐 Set SENTRY_DSN in environment — Sentry is completely inert when Dsn is empty"
  },
  "AllowedHosts": "*",
  "RequestTimeout": {
    "TimeoutSeconds": 200
  },
  "Security": {
    "CSRFSecretKey": "",
    "Comment_CSRF": "🔐 REQUIRED: Set CSRF_SECRET_KEY in .env file. Generate with: [Convert]::ToBase64String((1..32 | %{Get-Random -Max 256}))",
    "RateLimitPerMinute": 100,
    "EnableXssProtection": true,
    "EnableSqlInjectionProtection": true
  },
  "Encryption": {
    "MasterKey": "",
    "InitializationVector": "",
    "Comment": "IMPORTANT: In production, configure these in Azure Key Vault or environment variables. Leave empty for auto-generation in development (not recommended for production)."
  },
  "RateLimit": {
    "WellKnown": {
      "MaxRequests": 3,
      "WindowMinutes": 60
    },
    "General": {
      "MaxRequests": 1000,
      "WindowMinutes": 60
    }
  },
  "OAuth": {
    "Google": {
      "WebClientId": "REPLACE_WITH_GOOGLE_WEB_CLIENT_ID.apps.googleusercontent.com",
      "IosClientId": "REPLACE_WITH_GOOGLE_IOS_CLIENT_ID.apps.googleusercontent.com",
      "AndroidClientId": "REPLACE_WITH_GOOGLE_ANDROID_CLIENT_ID.apps.googleusercontent.com"
    },
    "Apple": {
      "ServiceId": "club.gathergrove.service",
      "BundleId": "club.gathergrove.ios",
      "Comment": "🔐 REQUIRED for SSO: Configure in Apple Developer Portal"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ]
  }
}
