{
  "$schema": "https://json.schemastore.org/appsettings.json",
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Hosting": "Information",
      "Microsoft.Extensions.Http": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "GatherGrove.API.Middleware.RequestLoggingMiddleware": "Information",
      "GatherGrove.API.Middleware.DatabaseLoggingInterceptor": "Warning",
      "GatherGrove.API.Middleware.GlobalExceptionMiddleware": "Error"
    },
    "Console": {
      "IncludeScopes": false,
      "TimestampFormat": "yyyy-MM-dd HH:mm:ss.fff zzz ",
      "DisableColors": true
    },
    "EventSource": {
      "LogLevel": {
        "Default": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "",
    "Redis": ""
  },
  "JwtSettings": {
    "SecretKey": "",
    "Issuer": "GatherGrove",
    "Audience": "GatherGrove",
    "ExpiryMinutes": "60",
    "ClockSkew": "5",
    "ValidateIssuer": true,
    "ValidateAudience": true,
    "ValidateLifetime": true,
    "ValidateIssuerSigningKey": true
  },
  "App": {
    "FrontendUrl": "https://www.gathergrove.club",
    "ApiUrl": "https://api.gathergrove.club",
    "IsDevelopmentMode": false,
    "RequireHttps": true,
    "EnableSwagger": false,
    "EnableDetailedErrors": false
  },
  "Stripe": {
    "SecretKey": "",
    "PublishableKey": "",
    "WebhookSecret": "",
    "GrowMonthlyPriceId": "",
    "GrowAnnualPriceId": "",
    "UnlimitedMonthlyPriceId": "",
    "UnlimitedAnnualPriceId": "",
    "SeedMonthlyPriceId": "",
    "SeedAnnualPriceId": "",
    "IsConnectEnabled": true,
    "DefaultCountry": "US",
    "PlatformCountry": "US",
    "ApiVersion": "2023-10-16",
    "Timeout": 30000
  },
  "AllowedHosts": [
    "api.gathergrove.club",
    "gathergrove.club",
    "*.gathergrove.club"
  ],
  "RequestTimeout": {
    "TimeoutSeconds": 30
  },
  "Security": {
    "RateLimitPerMinute": 1000,
    "EnableXssProtection": true,
    "EnableSqlInjectionProtection": true,
    "EnableCorsValidation": true,
    "MaxRequestBodySize": 10485760,
    "EnableSecurityHeaders": true,
    "EnableHsts": true,
    "HstsMaxAge": 31536000,
    "EnableContentSecurityPolicy": true
  },
  "RateLimit": {
    "WellKnown": {
      "MaxRequests": 5,
      "WindowMinutes": 60,
      "EnableIpBasedLimiting": true
    },
    "General": {
      "MaxRequests": 10000,
      "WindowMinutes": 60,
      "EnableIpBasedLimiting": true
    },
    "Authentication": {
      "MaxRequests": 100,
      "WindowMinutes": 60,
      "EnableIpBasedLimiting": true
    },
    "Payment": {
      "MaxRequests": 50,
      "WindowMinutes": 60,
      "EnableIpBasedLimiting": true
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "https://gathergrove.club",
      "https://www.gathergrove.club",
      "https://app.gathergrove.club"
    ],
    "AllowedMethods": [
      "GET",
      "POST",
      "PUT",
      "DELETE",
      "OPTIONS"
    ],
    "AllowedHeaders": [
      "Content-Type",
      "Authorization",
      "X-Requested-With",
      "Accept",
      "Origin",
      "User-Agent"
    ],
    "AllowCredentials": true,
    "MaxAge": 86400
  },
  "HealthChecks": {
    "TimeoutSeconds": 10,
    "DetailedOutput": false,
    "EnableDatabaseCheck": true,
    "EnableExternalServiceChecks": true
  },
  "Caching": {
    "DefaultExpirationMinutes": 30,
    "EnableResponseCaching": true,
    "EnableMemoryCache": true,
    "EnableRedisCache": true,
    "RedisConnectionString": "@Microsoft.KeyVault(SecretUri=https://gathergrove-keyvault-v2.vault.azure.net/secrets/ConnectionStrings--Redis/)"
  },
  "Monitoring": {
    "EnableMetrics": true,
    "EnableTracing": true,
    "SampleRate": 0.1,
    "EnableCustomMetrics": true
  },
  "Database": {
    "ConnectionTimeout": 30,
    "CommandTimeout": 60,
    "EnableRetryOnFailure": true,
    "MaxRetryCount": 3,
    "MaxRetryDelay": "00:00:30",
    "EnableSensitiveDataLogging": false,
    "EnableDetailedErrors": false
  },
  "Email": {
    "DefaultFromName": "GatherGrove",
    "EnableTemplateRendering": true,
    "MaxRecipientsPerEmail": 50,
    "EnableBatchSending": true
  },
  "Files": {
    "MaxFileSizeBytes": 10485760,
    "AllowedExtensions": [
      ".jpg",
      ".jpeg",
      ".png",
      ".gif",
      ".pdf",
      ".doc",
      ".docx"
    ],
    "StorageProvider": "Azure",
    "EnableVirusScanning": true
  }
}
