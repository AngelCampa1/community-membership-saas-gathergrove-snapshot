# ============================================================================
# GatherGrove Backend Environment Variables
# ============================================================================
# SECURITY NOTICE: NEVER commit .env to source control!
# Copy this file to .env and fill in your actual values
#
# For production/staging: Use Azure Key Vault (see AZURE-KEY-VAULT-SETUP.md)
# For development: Use this .env file with secure random values
# ============================================================================

# ----------------------------------------------------------------------------
# JWT Authentication Settings (CRITICAL - REQUIRED)
# ----------------------------------------------------------------------------
# Generate a secure 256-bit (32 byte) secret key for JWT token signing
#
# Methods to generate:
# - PowerShell: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Max 256 }))
# - Linux/Mac: openssl rand -base64 32
# - Node.js: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# MINIMUM LENGTH: 32 characters (256 bits)
# NEVER use weak keys like "secret", "test", or predictable values
JWT_SECRET_KEY=

# ----------------------------------------------------------------------------
# Stripe Payment Integration (CRITICAL - REQUIRED for payments)
# ----------------------------------------------------------------------------
# Get your keys from: https://dashboard.stripe.com/apikeys
#
# For development: Use test keys (starting with sk_test_ and pk_test_)
# For production: Use live keys (starting with sk_live_ and pk_live_)
#
# Test Secret Key (from Stripe Dashboard > Developers > API keys)
STRIPE_SECRET_KEY=

# Test Publishable Key (safe to expose in frontend)
STRIPE_PUBLISHABLE_KEY=

# Webhook Signing Secret (from Stripe Dashboard > Developers > Webhooks)
# Used to verify webhook authenticity and prevent tampering
# Get this after setting up webhook endpoint at: /api/v1/billing/webhook
STRIPE_WEBHOOK_SECRET=

# ----------------------------------------------------------------------------
# CSRF Protection (CRITICAL - REQUIRED)
# ----------------------------------------------------------------------------
# Generate a secure random secret for CSRF token signing
#
# Methods to generate:
# - PowerShell: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Max 256 }))
# - Linux/Mac: openssl rand -base64 32
#
# MINIMUM LENGTH: 32 characters
# NEVER use the fallback value from CSRFProtectionMiddleware.cs
CSRF_SECRET_KEY=

# ----------------------------------------------------------------------------
# Data Encryption (CRITICAL - REQUIRED for GDPR compliance)
# ----------------------------------------------------------------------------
# AES-256 encryption requires:
# - MasterKey: 32 bytes (256 bits)
# - InitializationVector (IV): 16 bytes (128 bits)
#
# Generate secure keys:
# - PowerShell:
#   $key = [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Max 256 }))
#   $iv = [Convert]::ToBase64String((1..16 | ForEach-Object { Get-Random -Max 256 }))
# - Linux/Mac:
#   openssl rand -base64 32  # for MasterKey
#   openssl rand -base64 16  # for IV
#
# IMPORTANT: Once set in production, DO NOT change these or encrypted data will be unreadable!
# Implement key rotation strategy if you need to change keys
ENCRYPTION_MASTER_KEY=
ENCRYPTION_IV=

# ----------------------------------------------------------------------------
# Cookie Domain (REQUIRED for production)
# ----------------------------------------------------------------------------
# Set to your domain for cross-subdomain cookie sharing
# Examples:
# - Development: localhost
# - Production: .gathergrove.club (note the leading dot)
COOKIE_DOMAIN=localhost

# ----------------------------------------------------------------------------
# Database Connection (Optional - defaults to LocalDB)
# ----------------------------------------------------------------------------
# Override the default LocalDB connection string if needed
# Default: Server=(localdb)\\mssqllocaldb;Database=GatherGroveDb;Trusted_Connection=true
# CONNECTION_STRING=

# ----------------------------------------------------------------------------
# Email Sender (Resend)
# ----------------------------------------------------------------------------
# Display name and address used for all outbound emails from GatherGrove
RESEND_FROM_ADDRESS=Angel Campa <noreply@gathergrove.club>

# ----------------------------------------------------------------------------
# Azure Communication Services (Optional - for email/SMS/WhatsApp)
# ----------------------------------------------------------------------------
# Get your connection string from: Azure Portal > Communication Services
# Leave empty to use mock email service in development
AZURE_COMMUNICATION_SERVICES_CONNECTION_STRING=

# ----------------------------------------------------------------------------
# Azure Storage (Optional - for file uploads)
# ----------------------------------------------------------------------------
# Get your connection string from: Azure Portal > Storage Accounts
# Leave empty to use mock file storage in development
AZURE_STORAGE_CONNECTION_STRING=

# ----------------------------------------------------------------------------
# Application Insights (Optional - for monitoring)
# ----------------------------------------------------------------------------
# Get your instrumentation key from: Azure Portal > Application Insights
# Leave empty to disable telemetry in development
APPLICATION_INSIGHTS_INSTRUMENTATION_KEY=

# ----------------------------------------------------------------------------
# Push Notifications (Optional - for mobile apps)
# ----------------------------------------------------------------------------
# Azure Notification Hubs (unified push notification service for iOS and Android)
# Get your connection string from: Azure Portal > Notification Hubs
# Supports both FCM (Android) and APNs (iOS) through single Azure service
# Leave empty to use mock push notification service in development
AZURE_NOTIFICATION_HUB_CONNECTION_STRING=
AZURE_NOTIFICATION_HUB_NAME=

# Note: Configure FCM and APNs credentials in Azure Notification Hub settings:
# - Android: Add FCM Server Key in Notification Hub > Google (FCM) settings
# - iOS: Upload APNs certificate or add APNs token in Notification Hub > Apple (APNS) settings

# ----------------------------------------------------------------------------
# Development/Testing Settings (Optional)
# ----------------------------------------------------------------------------
# Set to 'true' to enable detailed logging
ENABLE_DETAILED_LOGGING=false

# Set to 'true' to disable authentication (DEV ONLY)
DISABLE_AUTH=false

# ============================================================================
# SECURITY CHECKLIST
# ============================================================================
# Before deploying to production, ensure:
# ✅ All CRITICAL secrets are configured
# ✅ JWT_SECRET_KEY is at least 32 characters and cryptographically random
# ✅ STRIPE_SECRET_KEY starts with sk_live_ (not sk_test_)
# ✅ CSRF_SECRET_KEY is unique and random
# ✅ ENCRYPTION_MASTER_KEY and ENCRYPTION_IV are set and backed up securely
# ✅ COOKIE_DOMAIN matches your production domain
# ✅ This .env file is NOT committed to git (.gitignore includes .env)
# ✅ Production secrets are stored in Azure Key Vault
# ✅ Access to Azure Key Vault is restricted via RBAC
# ✅ Key rotation schedule is documented
# ============================================================================
