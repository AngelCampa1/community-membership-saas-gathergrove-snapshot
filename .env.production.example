# Production Environment Variables for GatherGrove
# Copy this file to .env.production and fill in your actual production values

# CRITICAL SECURITY: SQL Server Configuration
# Use Azure Key Vault or secure secret management in production
SA_PASSWORD_SECRET=${SA_PASSWORD_FROM_KEYVAULT}

# JWT Configuration - Use Azure Key Vault
JWT_SECRET_KEY=${JWT_SECRET_FROM_KEYVAULT}

# Stripe Production Keys - Use Azure Key Vault
STRIPE_SECRET_KEY=${STRIPE_SECRET_FROM_KEYVAULT}
STRIPE_PUBLISHABLE_KEY=${STRIPE_PUBLISHABLE_FROM_KEYVAULT}
STRIPE_WEBHOOK_SECRET=${STRIPE_WEBHOOK_FROM_KEYVAULT}

# Database Configuration for Production
CONNECTION_STRING=${AZURE_SQL_CONNECTION_FROM_KEYVAULT}

# Production Settings
USE_INMEMORY_DB=false
ASPNETCORE_ENVIRONMENT=Production
REQUIRE_HTTPS=true

# Security Configuration
Security__RateLimitPerMinute=100
Security__EnableXssProtection=true
Security__EnableSqlInjectionProtection=true

# Azure Configuration
AZURE_KEY_VAULT_URL=${AZURE_KEY_VAULT_URL}
AZURE_CLIENT_ID=${AZURE_CLIENT_ID}
AZURE_CLIENT_SECRET=${AZURE_CLIENT_SECRET}
AZURE_TENANT_ID=${AZURE_TENANT_ID}